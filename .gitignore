# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
**/.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Playwright
test-results/
playwright-report/
playwright/.auth/

# Capacitor/Android: the platform dirs live under app/, so app/.gitignore owns
# their paths. These patterns are unanchored and still catch a stray at root.
**/capacitor.build.gradle
**/capacitor.settings.gradle
*.jks
*.keystore

# Desktop release build outputs (Electron DMGs)
/desktop_release_builds/*
!/desktop_release_builds/electron
/desktop_release_builds/electron/*
!/desktop_release_builds/electron/.gitkeep

# Sphinx docs build
docs/_build/

# Claude Code CLI
.claude/settings.local.json

# Ruby/Bundler
.bundle/
vendor/bundle/
.grepai/
.superpowers/
.codegraph/
.tokensave/

# Release notice temp drafts
.notice-draft-*.json

# LlamaKit SPM build artifacts
app/ios/App/LlamaKit/.build/
