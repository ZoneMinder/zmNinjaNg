    "test:all": "npm --prefix app run test:all",
    "notice": "node scripts/generate_notice.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "analyze": "npm --prefix app run analyze",
    "android:sync": "npm --prefix app run android:sync",
    "android:run": "npm --prefix app run android:run",
    "android": "npm --prefix app run android",
    "android:open": "npm --prefix app run android:open",
    "android:logs": "npm --prefix app run android:logs",
    "android:devices": "npm --prefix app run android:devices",
    "android:release": "npm --prefix app run android:release",
    "android:bundle": "npm --prefix app run android:bundle",
    "ios:sync": "npm --prefix app run ios:sync",
    "ios:run": "npm --prefix app run ios:run",
    "ios": "npm --prefix app run ios",
    "ios:open": "npm --prefix app run ios:open",
    "electron:dev": "npm --prefix app run electron:dev",
    "electron:start": "npm --prefix app run electron:start",
    "electron:build": "npm --prefix app run electron:build",
    "electron:build:nosign": "npm --prefix app run electron:build:nosign",
    "icons": "npm --prefix app run icons",
    "prepare": "husky"
