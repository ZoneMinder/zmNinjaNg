{
  "private": true,
  "scripts": {
    "dev": "npm --prefix app run dev",
    "proxy": "npm --prefix app run proxy",
    "dev:all": "npm --prefix app run dev:all",
    "mock:notifications": "npm --prefix app run mock:notifications",
    "dev:notifications": "npm --prefix app run dev:notifications",
    "build": "npm --prefix app run build",
    "lint": "npm --prefix app run lint",
    "preview": "npm --prefix app run preview",
    "test": "npm --prefix app test",
    "test:ui": "npm --prefix app run test:ui",
    "test:coverage": "npm --prefix app run test:coverage",
    "test:watch": "npm --prefix app run test:watch",
    "test:unit": "npm --prefix app run test:unit",
    "test:e2e": "sh -c 'if [ $# -eq 0 ]; then npm --prefix app run test:e2e:full; else npm --prefix app run test:e2e -- \"$@\"; fi' sh",
