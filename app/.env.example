# Environment Variables Template
#
# Copy this file to .env and fill in your values for development/testing.
# The .env file is gitignored and should never be committed.

# Test Account 1: required by browser e2e, which stops without all three
ZM_HOST_1=https://your-zoneminder-server.com
ZM_USER_1=your-username
ZM_PASSWORD_1=your-password

# Test Account 2 (Example: Your own ZoneMinder server)
ZM_HOST_2=https://your-zoneminder-server.com
ZM_USER_2=your-username
ZM_PASSWORD_2=your-password
