<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ML Kit GenAI (GeminiNanoPlugin, issue #270) declares minSdk 26 while this app
         supports 24. Overridden rather than raising the app's floor: that would drop
         Android 7 users for a backend they could never run anyway, since AICore does not
         exist below Android 14. The library contributes no components to the merged
         manifest, only a permission and a <queries> entry, and GeminiNanoPlugin refuses
         every call below API 26 so none of its classes are touched there. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt, com.google.mlkit.genai.common" />
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/app_icon_flat"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:banner="@drawable/app_icon_flat"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PipActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar"
        />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Analytics is not used. The Analytics/Measurement SDK is not a
             dependency (only firebase-messaging, which pulls the dormant
             measurement-connector interface). These flags declare analytics off so
             nothing is collected even if the Analytics SDK is ever added. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />

        <!-- Route FCM notification messages that omit a channel_id (the ZM event
             server does not set one) to our high-importance "zmninja-ng" channel
             instead of FCM's default "Miscellaneous" fallback channel, so alerts
             show a heads-up banner. Must match the id in
             services/pushNotifications.ts createChannel(). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="zmninja-ng" />

        <!-- Status-bar icon for FCM notifications that name none. The ZM event
             server names ic_stat_notification itself; without the drawable,
             Android draws the launcher icon as a blank white circle (refs #540). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_notification" />
    </application>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_LOCAL_NETWORK is deliberately absent. While we target API 36 local
         network access comes with INTERNET, and declaring the permission early gives
         that implicit grant up: on Android 17 the NEARBY_DEVICES toggle appears
         default-denied, nothing in the app requests it, and every LAN ZoneMinder
         server times out (#350, shipped briefly in 2.2.0 build 2685). The declaration
         and its runtime request belong together in the change that raises
         targetSdkVersion to 37, where the permission becomes mandatory. -->
    <!-- @capacitor-community/media saves downloads to the app's own gallery album
         via MediaStore. In basic (non-gallery) mode it requests no storage/media
         permissions, so READ_MEDIA_IMAGES/READ_MEDIA_VIDEO and the legacy
         external-storage permissions are not declared. Google Play rejects
         READ_MEDIA_* unless broad library access is the core purpose (refs #190). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
